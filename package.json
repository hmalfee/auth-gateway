{
    "name": "auth-gateway",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "next build",
        "postbuild": "node scripts/next-standalone-postbuild.js",
        "check": "tsc --noEmit && pnpm lint && pnpm knip && pnpm format --check",
        "predev": "pnpx @better-auth/cli@latest migrate --config src/lib/auth.ts -y",
        "dev": "next dev",
        "format": "prettier --cache --write .",
        "knip": "knip",
        "lint": "eslint",
        "prestart": "pnpx @better-auth/cli@latest migrate --config src/lib/auth.ts -y",
        "start": "next start"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "better-auth": "^1.6.25",
        "better-sqlite3": "^13.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "next": "16.3.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "^4.16.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@tailwindcss/postcss": "^4",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.0",
        "knip": "^6.29.0",
        "prettier": "^3.9.6",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sh": "^0.19.0",
        "prettier-plugin-sql": "^0.20.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "zx": "^8.8.5"
    },
    "packageManager": "pnpm@11.17.0"
}
